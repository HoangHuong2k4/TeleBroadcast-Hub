<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <defs>
    <!-- Background Gradient -->
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f172a" />
      <stop offset="50%" stop-color="#0284c7" />
      <stop offset="100%" stop-color="#4f46e5" />
    </linearGradient>

    <!-- Glowing Cyan Gradient -->
    <linearGradient id="planeGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="100%" stop-color="#e0f2fe" />
    </linearGradient>

    <!-- Signal Arc Gradient -->
    <linearGradient id="arcGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.9" />
      <stop offset="100%" stop-color="#818cf8" stop-opacity="0.2" />
    </linearGradient>

    <!-- Drop Shadow Filter -->
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="8" stdDeviation="16" flood-color="#0ea5e9" flood-opacity="0.45" />
    </filter>
    <filter id="arcGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="8" flood-color="#38bdf8" flood-opacity="0.6" />
    </filter>
  </defs>

  <!-- Squircle Base with Border -->
  <rect x="24" y="24" width="464" height="464" rx="120" fill="url(#bgGrad)" stroke="#38bdf8" stroke-width="6" stroke-opacity="0.4" filter="url(#glow)" />

  <!-- Broadcast Pulse Circles / Waves in Background -->
  <circle cx="210" cy="270" r="160" fill="none" stroke="url(#arcGrad)" stroke-width="4" stroke-dasharray="8 8" opacity="0.4" />
  <circle cx="210" cy="270" r="110" fill="none" stroke="url(#arcGrad)" stroke-width="4" stroke-dasharray="6 6" opacity="0.6" />

  <!-- Radiating Broadcast Waves (Top Right) -->
  <path d="M 320 140 A 180 180 0 0 1 420 240" fill="none" stroke="#38bdf8" stroke-width="14" stroke-linecap="round" filter="url(#arcGlow)" />
  <path d="M 290 170 A 130 130 0 0 1 370 250" fill="none" stroke="#60a5fa" stroke-width="12" stroke-linecap="round" filter="url(#arcGlow)" opacity="0.85" />
  <path d="M 260 200 A 80 80 0 0 1 320 260" fill="none" stroke="#93c5fd" stroke-width="10" stroke-linecap="round" filter="url(#arcGlow)" opacity="0.7" />

  <!-- Stylized Telegram Paper Plane -->
  <g transform="translate(10, 20)">
    <!-- Main Plane Body -->
    <path d="M 120 260 L 330 140 L 175 315 L 165 385 L 215 335 L 295 380 L 375 120 Z" 
          fill="url(#planeGrad)" 
          filter="url(#glow)" />
    <!-- Wing Shadow / Crease Fold -->
    <path d="M 330 140 L 175 315 L 215 335 Z" fill="#93c5fd" opacity="0.75" />
    <!-- Bottom Fin -->
    <path d="M 175 315 L 165 385 L 215 335 Z" fill="#60a5fa" opacity="0.9" />
  </g>

  <!-- Center Signal Dot -->
  <circle cx="225" cy="305" r="7" fill="#38bdf8" filter="url(#arcGlow)" />
</svg>
